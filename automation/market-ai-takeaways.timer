[Unit]
Description=Market AI Takeaways Refresh Timer
Requires=market-ai-takeaways.service

[Timer]
# The API expires snapshots after six hours and news uses a rolling 24-hour
# window, so refresh hourly even overnight and on non-trading days.
OnCalendar=*-*-* *:10:00
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
