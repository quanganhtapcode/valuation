[Unit]
Description=Back up complete Valuation data to OneDrive and verify restoration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/valuation
ExecStart=/var/www/valuation/.venv/bin/python -m automation.backup_valuation_data --keep-remote 5
UMask=0077
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
